{
  "expo": {
    "name": "MassCode",
    "slug": "masscode",
    "scheme": "masscode",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.apkiosk.masscode.mobile",
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSMicrophoneUsageDescription": "MassCode listens while you dictate a message, and turns your words into text on this iPhone."
      },
      "icon": "./assets/app.icon"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "26.0"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "MassCode scans the pairing code your Mac shows in Settings → Phone."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "MassCode attaches the photos you pick to your messages."
        }
      ],
      "expo-secure-store",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "platforms": ["ios"]
  }
}
