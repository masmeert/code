{
  "expo": {
    "name": "MassCode",
    "slug": "masscode",
    "scheme": "masscode",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.apkiosk.masscode.mobile",
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": { "NSAllowsArbitraryLoads": true }
      }
    },
    "android": {
      "package": "com.apkiosk.masscode.mobile"
    },
    "plugins": [
      "expo-router",
      ["expo-build-properties", { "android": { "usesCleartextTraffic": true } }],
      [
        "expo-camera",
        {
          "cameraPermission": "MassCode scans the pairing code your Mac shows in Settings → Phone.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store",
      [
        "expo-font",
        {
          "ios": {
            "fonts": [
              "./assets/fonts/Figtree-Regular.ttf",
              "./assets/fonts/Figtree-Italic.ttf",
              "./assets/fonts/Figtree-Medium.ttf",
              "./assets/fonts/Figtree-SemiBold.ttf",
              "./assets/fonts/Figtree-Bold.ttf"
            ]
          },
          "android": {
            "fonts": [
              {
                "fontFamily": "Figtree",
                "fontDefinitions": [
                  { "path": "./assets/fonts/Figtree-Regular.ttf", "weight": 400 },
                  { "path": "./assets/fonts/Figtree-Italic.ttf", "weight": 400, "style": "italic" },
                  { "path": "./assets/fonts/Figtree-Medium.ttf", "weight": 500 },
                  { "path": "./assets/fonts/Figtree-SemiBold.ttf", "weight": 600 },
                  { "path": "./assets/fonts/Figtree-Bold.ttf", "weight": 700 }
                ]
              }
            ]
          }
        }
      ]
    ],
    "experiments": { "typedRoutes": true }
  }
}
