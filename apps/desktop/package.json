{
  "name": "@apcode/desktop",
  "version": "0.0.5",
  "private": true,
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "bun build src/main.ts src/preload.ts --target=node --format=cjs --external=electron --sourcemap=linked --outdir=dist --entry-naming='[name].cjs'",
    "dev": "node scripts/dev.mjs",
    "dist": "pnpm build && electron-builder",
    "release": "pnpm build && electron-builder --publish always",
    "typecheck": "tsc -p ."
  },
  "devDependencies": {
    "@apcode/contracts": "workspace:*",
    "@types/node": "^24.0.0",
    "effect": "catalog:",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "typescript": "catalog:"
  },
  "productName": "APCode"
}
