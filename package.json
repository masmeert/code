{
  "name": "masscode",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @masscode/daemon --filter @masscode/web --filter @masscode/desktop dev",
    "dev:daemon": "pnpm --filter @masscode/daemon dev",
    "dev:web": "pnpm --filter @masscode/web dev",
    "build": "pnpm --filter @masscode/daemon build && pnpm --filter @masscode/web build && pnpm --filter @masscode/desktop dist",
    "release": "pnpm --filter @masscode/daemon build && pnpm --filter @masscode/web build && pnpm --filter @masscode/desktop release",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @masscode/daemon test",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix --no-error-on-unmatched-pattern",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.85.0",
    "lint-staged": "^17.5.1",
    "oxfmt": "^0.70.0",
    "oxlint": "1.85.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "oxlint --fix --no-error-on-unmatched-pattern",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc,md,css,yaml,yml,html}": "oxfmt --no-error-on-unmatched-pattern"
  },
  "packageManager": "pnpm@11.22.0"
}
